# ==============================================================================
# VELOR MONOREPO ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env in your workspace root or individual app directories.
# Replace all placeholder values with your actual credentials.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (packages/db & apps/api)
# ------------------------------------------------------------------------------
# PostgreSQL connection URL (e.g. Neon PostgreSQL or local Postgres connection)
DATABASE_URL="postgresql://[YOUR_DB_USER]:[YOUR_DB_PASSWORD]@[YOUR_DB_HOST]:5432/[YOUR_DB_NAME]?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SERVER & API CONFIGURATION (apps/api)
# ------------------------------------------------------------------------------
# Port for the Express REST API server
PORT=4000

# Base URL for Express REST API (used by frontend web app)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION CONFIGURATION (Clerk - apps/web & apps/api)
# ------------------------------------------------------------------------------
# Clerk Publishable Key (from Clerk Dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_[YOUR_CLERK_PUBLISHABLE_KEY]"
CLERK_PUBLISHABLE_KEY="pk_test_[YOUR_CLERK_PUBLISHABLE_KEY]"

# Clerk Secret Key (from Clerk Dashboard - keep secret!)
CLERK_SECRET_KEY="sk_test_[YOUR_CLERK_SECRET_KEY]"

# ------------------------------------------------------------------------------
# 4. AI INTEGRATION (Groq SDK - apps/api & apps/web)
# ------------------------------------------------------------------------------
# API Key for Groq LLM inference service (from https://console.groq.com)
GROQ_API_KEY="gsk_[YOUR_GROQ_API_KEY]"

# ------------------------------------------------------------------------------
# 5. GITHUB WEBHOOK INTEGRATION (apps/api)
# ------------------------------------------------------------------------------
# Secret signature used to verify incoming GitHub webhook events
GITHUB_WEBHOOK_SECRET="[YOUR_GITHUB_WEBHOOK_SECRET_KEY]"
